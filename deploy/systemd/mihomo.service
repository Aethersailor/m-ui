[Unit]
Description=Mihomo proxy core managed by m-ui
Documentation=https://wiki.metacubex.one/en/startup/service/
After=network-online.target m-ui.service
Wants=network-online.target
Requires=m-ui.service

[Service]
Type=simple
User=mihomo
Group=mihomo
WorkingDirectory=/var/lib/mihomo
Environment=HOME=/var/lib/mihomo
Environment=SAFE_PATHS=/etc/mihomo
ExecStartPre=/usr/sbin/runuser -u m-ui -- /usr/bin/m-ui runtime wait-ready
ExecStart=/var/lib/m-ui/core/current/mihomo -d /var/lib/mihomo -f /etc/mihomo/config.yaml
PermissionsStartOnly=true
ExecStartPost=/usr/sbin/runuser -u m-ui -- /usr/bin/m-ui runtime finalize-mihomo-start --config /etc/m-ui/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStartSec=180s
LimitNOFILE=1000000
UMask=0027

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/etc/mihomo
ReadWritePaths=/var/lib/mihomo
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
